# Supabase → Project Settings → API. Both values are public; data is protected by row level security.
# Leave them empty to run in local mode (no sign-in, tasks stay in this browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Push notifications (server only). Generate a key pair with: node scripts/vapid-keys.mjs
# In production VAPID_PUBLIC_KEY is in wrangler.jsonc and the rest are Worker secrets (npx wrangler secret put NAME).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Supabase → Project Settings → API Keys → secret key. Only the overdue job uses it.
SUPABASE_SECRET_KEY=
# Any long random string; protects /api/cron/overdue.
CRON_SECRET=
